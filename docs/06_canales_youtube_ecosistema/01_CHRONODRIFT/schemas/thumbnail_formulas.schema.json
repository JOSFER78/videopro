{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChronoDriftThumbnailFormulasSchema",
  "description": "Schema de validación para las 5 fórmulas maestras de miniaturas de alto CTR (>14%) y plantillas de neurodiseño para CHRONODRIFT",
  "type": "object",
  "required": [
    "schema_version",
    "channel_id",
    "target_ctr_threshold",
    "canvas_specs",
    "dead_zone_restriction",
    "cognitive_triad_rule",
    "color_tokens",
    "typography_rules",
    "master_formulas",
    "quality_assurance_protocol"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$" },
    "channel_id": { "type": "string", "pattern": "^[0-9]{2}_[A-Z0-9_]+$" },
    "target_ctr_threshold": { "type": "string" },
    "canvas_specs": {
      "type": "object",
      "required": ["width", "height", "aspect_ratio", "color_space", "preattentive_processing_ms"],
      "properties": {
        "width": { "type": "integer", "const": 1920 },
        "height": { "type": "integer", "const": 1080 },
        "aspect_ratio": { "type": "string", "const": "16:9" },
        "color_space": { "type": "string", "enum": ["sRGB", "Rec.709", "Display P3"] },
        "preattentive_processing_ms": { "type": "integer", "maximum": 250 }
      }
    },
    "dead_zone_restriction": {
      "type": "object",
      "required": ["corner", "width_px", "height_px", "allowed_elements"],
      "properties": {
        "corner": { "type": "string", "enum": ["bottom-right", "bottom-left", "top-right", "top-left"] },
        "width_px": { "type": "integer" },
        "height_px": { "type": "integer" },
        "allowed_elements": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "cognitive_triad_rule": {
      "type": "object",
      "required": ["max_visual_anchors", "element_1_role", "element_2_role", "element_3_role"],
      "properties": {
        "max_visual_anchors": { "type": "integer", "const": 3 },
        "element_1_role": { "type": "string" },
        "element_2_role": { "type": "string" },
        "element_3_role": { "type": "string" }
      }
    },
    "color_tokens": {
      "type": "object",
      "patternProperties": {
        "^[A-Za-z0-9_]+$": {
          "type": "object",
          "required": ["hex", "rgb", "role", "wcag_contrast_on_void"],
          "properties": {
            "hex": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
            "rgb": { "type": "string" },
            "role": { "type": "string" },
            "wcag_contrast_on_void": { "type": "string" }
          }
        }
      }
    },
    "typography_rules": {
      "type": "object",
      "required": ["max_words_microcopy", "primary_display_font", "hud_font", "stroke_layers"],
      "properties": {
        "max_words_microcopy": { "type": "integer", "maximum": 4 },
        "primary_display_font": { "type": "string" },
        "hud_font": { "type": "string" },
        "stroke_layers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["layer", "width_px", "color_hex"],
            "properties": {
              "layer": { "type": "string" },
              "width_px": { "type": "integer" },
              "color_hex": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
            }
          }
        }
      }
    },
    "master_formulas": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "formula_id",
          "code_name",
          "display_name",
          "projected_ctr_range",
          "cognitive_concept",
          "geometric_composition",
          "layer_hierarchy",
          "canonical_microcopy",
          "chromatic_distribution",
          "prompt_flux_3",
          "compatible_title_formulas"
        ],
        "properties": {
          "formula_id": { "type": "string", "pattern": "^F[1-5]$" },
          "code_name": { "type": "string" },
          "display_name": { "type": "string" },
          "projected_ctr_range": { "type": "string" },
          "cognitive_concept": { "type": "string" },
          "geometric_composition": { "type": "string" },
          "layer_hierarchy": {
            "type": "object",
            "required": ["L1_background", "L2_midground", "L3_foreground_hud"],
            "properties": {
              "L1_background": { "type": "string" },
              "L2_midground": { "type": "string" },
              "L3_foreground_hud": { "type": "string" }
            }
          },
          "canonical_microcopy": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 30
            }
          },
          "chromatic_distribution": { "type": "string" },
          "prompt_flux_3": { "type": "string" },
          "compatible_title_formulas": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "quality_assurance_protocol": {
      "type": "object",
      "required": ["squint_test_resolutions", "mandatory_checklist_items", "dynamic_rotation_phases"],
      "properties": {
        "squint_test_resolutions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "mandatory_checklist_items": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dynamic_rotation_phases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["phase", "timeframe", "variant_role", "ctr_target"],
            "properties": {
              "phase": { "type": "string" },
              "timeframe": { "type": "string" },
              "variant_role": { "type": "string" },
              "ctr_target": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
