{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FPVUrbanStoryManifestSchema",
  "description": "Contrato formal de manifiesto de producción integral para Tours FPV y Storytelling Urbano en videopro.",
  "type": "object",
  "required": [
    "project_id",
    "project_name",
    "city",
    "country",
    "workflow_archetype",
    "target_aspect_ratio",
    "target_fps",
    "engine_configuration",
    "pipeline_stages",
    "assets_registry"
  ],
  "properties": {
    "project_id": { "type": "string", "example": "2026-08-16_fpv-tokyo-shibuya-night" },
    "project_name": { "type": "string", "example": "Tokio FPV: El Pulso Vertical de Shibuya" },
    "city": { "type": "string", "example": "Tokio" },
    "country": { "type": "string", "example": "Japón" },
    "workflow_archetype": { "type": "string", "enum": ["FPV_URBAN_STORYTELLING"], "default": "FPV_URBAN_STORYTELLING" },
    "target_aspect_ratio": { "type": "string", "enum": ["9:16", "16:9", "21:9"], "default": "9:16" },
    "target_fps": { "type": "integer", "enum": [30, 60], "default": 60 },
    "engine_configuration": {
      "type": "object",
      "required": ["video_engine", "image_engine", "voice_engine", "music_engine", "render_backend"],
      "properties": {
        "video_engine": { "type": "string", "enum": ["gemini-omni-flash-preview"], "default": "gemini-omni-flash-preview" },
        "image_engine": { "type": "string", "enum": ["gemini-3.1-flash-image"], "default": "gemini-3.1-flash-image" },
        "voice_engine": { "type": "string", "enum": ["vibevoice", "edge_tts", "elevenlabs"], "default": "edge_tts" },
        "music_engine": { "type": "string", "default": "flow_music_lyria3" },
        "render_backend": { "type": "string", "enum": ["remotion", "moviepy", "ffmpeg_hybrid"], "default": "remotion" }
      }
    },
    "pipeline_stages": {
      "type": "object",
      "required": [
        "stage_1_scripting_and_flight_plan",
        "stage_2_scraping_real_grounding",
        "stage_3_keyframing_and_reimagining",
        "stage_4_google_flow_omni_render",
        "stage_5_audio_flow_sfx_sync",
        "stage_6_3d_spatial_titles_hud",
        "stage_7_master_assembly_qa"
      ],
      "properties": {
        "stage_1_scripting_and_flight_plan": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "enum": ["PENDING", "IN_PROGRESS", "COMPLETED", "FAILED"] },
            "flight_plan_ref": { "type": "string" },
            "total_shots": { "type": "integer", "default": 7 }
          }
        },
        "stage_2_scraping_real_grounding": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "enum": ["PENDING", "IN_PROGRESS", "COMPLETED", "FAILED"] },
            "scraped_images_count": { "type": "integer" },
            "resolution_filter_pass": { "type": "boolean" },
            "laplacian_variance_avg": { "type": "number" }
          }
        },
        "stage_3_keyframing_and_reimagining": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "enum": ["PENDING", "IN_PROGRESS", "COMPLETED", "FAILED"] },
            "total_keyframes_generated": { "type": "integer" },
            "location_bible_ref": { "type": "string" }
          }
        },
        "stage_4_google_flow_omni_render": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "enum": ["PENDING", "IN_PROGRESS", "COMPLETED", "FAILED"] },
            "rendered_clips_count": { "type": "integer" },
            "avg_generation_time_s": { "type": "number" }
          }
        },
        "stage_5_audio_flow_sfx_sync": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "enum": ["PENDING", "IN_PROGRESS", "COMPLETED", "FAILED"] },
            "narration_audio_ref": { "type": "string" },
            "whisper_timestamps_ref": { "type": "string" },
            "bgm_track_ref": { "type": "string" },
            "master_lufs": { "type": "number", "example": -14.1 }
          }
        },
        "stage_6_3d_spatial_titles_hud": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "enum": ["PENDING", "IN_PROGRESS", "COMPLETED", "FAILED"] },
            "remotion_composition_name": { "type": "string", "example": "FPVUrbanTourMain" },
            "telemetry_hud_active": { "type": "boolean", "default": true }
          }
        },
        "stage_7_master_assembly_qa": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "enum": ["PENDING", "IN_PROGRESS", "COMPLETED", "FAILED"] },
            "output_video_path": { "type": "string" },
            "file_size_bytes": { "type": "integer" },
            "bitrate_kbps": { "type": "integer" },
            "qa_passed": { "type": "boolean" }
          }
        }
      }
    },
    "assets_registry": {
      "type": "object",
      "description": "Registro de activos verificados con SHA256 y tamaño >5KB",
      "additionalProperties": {
        "type": "object",
        "required": ["file_path", "size_bytes", "sha256_hash", "verified_rule_5kb"],
        "properties": {
          "file_path": { "type": "string" },
          "size_bytes": { "type": "integer", "minimum": 5000 },
          "sha256_hash": { "type": "string" },
          "verified_rule_5kb": { "type": "boolean" }
        }
      }
    }
  }
}
