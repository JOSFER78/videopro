{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FPVUrbanFlightPlanSchema",
  "description": "Contrato formal para planes de vuelo cinemático FPV, waypoints 3D, telemetría y shotlist de Storytelling Urbano.",
  "type": "object",
  "required": ["flight_plan_id", "city", "country", "story_arc", "camera_spec", "drone_physics", "waypoints", "shots"],
  "properties": {
    "flight_plan_id": {
      "type": "string",
      "pattern": "^FPV_[A-Z]{3,4}_[0-9]{8}_[A-Z0-9]+$",
      "example": "FPV_TOKYO_20260816_SHIBUYA01"
    },
    "city": { "type": "string", "example": "Tokio" },
    "country": { "type": "string", "example": "Japón" },
    "narrative_theme": { "type": "string", "example": "El pulso nocturno de Shibuya: de la azotea del Scramble Square al laberinto de callejones Yokocho" },
    "story_arc": {
      "type": "object",
      "required": ["hook_seconds", "body_seconds", "climax_seconds", "narrative_counterpoint"],
      "properties": {
        "hook_seconds": { "type": "number", "minimum": 2.0, "maximum": 5.0, "example": 3.0 },
        "body_seconds": { "type": "number", "minimum": 15.0, "maximum": 120.0, "example": 35.0 },
        "climax_seconds": { "type": "number", "minimum": 4.0, "maximum": 15.0, "example": 7.0 },
        "narrative_counterpoint": {
          "type": "string",
          "example": "La voz en off relata la historia de la ingeniería antisísmica mientras la cámara FPV desafía la gravedad zigzagueando entre las torres."
        }
      }
    },
    "camera_spec": {
      "type": "object",
      "required": ["fov_degrees", "lens_simulation", "shutter_angle", "color_science", "aspect_ratio"],
      "properties": {
        "fov_degrees": { "type": "number", "minimum": 90, "maximum": 155, "example": 135 },
        "lens_simulation": { "type": "string", "example": "Ultra-wide Anamorphic 14mm f/2.8 with controlled barrel distortion" },
        "shutter_angle": { "type": "number", "example": 180 },
        "color_science": { "type": "string", "example": "ARRI Alexa LF with Kodak Vision3 500T 35mm grain" },
        "aspect_ratio": { "type": "string", "enum": ["16:9", "9:16", "21:9", "1:1"], "example": "9:16" }
      }
    },
    "drone_physics": {
      "type": "object",
      "required": ["max_speed_kmh", "cruise_speed_kmh", "roll_rate_deg_sec", "inertia_smoothing_factor"],
      "properties": {
        "max_speed_kmh": { "type": "number", "example": 140.0 },
        "cruise_speed_kmh": { "type": "number", "example": 65.0 },
        "roll_rate_deg_sec": { "type": "number", "example": 220.0 },
        "inertia_smoothing_factor": { "type": "number", "minimum": 0.0, "maximum": 1.0, "example": 0.85 }
      }
    },
    "waypoints": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": ["waypoint_id", "landmark_name", "latitude", "longitude", "altitude_meters_agl", "camera_pitch_deg", "camera_yaw_deg", "camera_roll_deg"],
        "properties": {
          "waypoint_id": { "type": "string", "example": "WP-001" },
          "landmark_name": { "type": "string", "example": "Shibuya Scramble Square Helipad" },
          "latitude": { "type": "number", "example": 35.6580 },
          "longitude": { "type": "number", "example": 139.7016 },
          "altitude_meters_agl": { "type": "number", "example": 229.0 },
          "camera_pitch_deg": { "type": "number", "minimum": -90.0, "maximum": 90.0, "example": -85.0 },
          "camera_yaw_deg": { "type": "number", "example": 180.0 },
          "camera_roll_deg": { "type": "number", "example": 15.0 },
          "focal_interest_poi": { "type": "string", "example": "Pedestrian crossing intersection" },
          "lighting_reference": { "type": "string", "example": "Golden hour neon reflections, blue twilight ambient 4500K" }
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": [
          "shot_index",
          "shot_name",
          "shot_type",
          "start_waypoint",
          "end_waypoint",
          "duration_seconds",
          "speed_kmh",
          "motion_type",
          "first_frame_asset_ref",
          "omni_flash_prompt",
          "hud_telemetry",
          "spatial_3d_title"
        ],
        "properties": {
          "shot_index": { "type": "integer", "minimum": 1, "maximum": 7 },
          "shot_name": { "type": "string", "example": "01_TERMINAL_DIVE_SCRAMBLE" },
          "shot_type": {
            "type": "string",
            "enum": [
              "TERMINAL_DIVE",
              "CANYON_SLALOM",
              "LOW_ALTITUDE_SKIM",
              "PORTAL_BREACH",
              "SPIRAL_ORBIT",
              "TUNNEL_DASH",
              "SKYLINE_ASCENSION"
            ]
          },
          "start_waypoint": { "type": "string", "example": "WP-001" },
          "end_waypoint": { "type": "string", "example": "WP-002" },
          "duration_seconds": { "type": "number", "minimum": 3.0, "maximum": 10.0, "example": 4.5 },
          "speed_kmh": { "type": "number", "example": 120.0 },
          "motion_type": { "type": "string", "example": "Vertical 90-degree nose-down terminal dive with progressive 45-degree roll rotation" },
          "first_frame_asset_ref": { "type": "string", "example": "assets/keyframes/kf0_shibuya_scramble_top_raw.png" },
          "image_ref_pack": {
            "type": "array",
            "items": { "type": "string" },
            "example": [
              "assets/keyframes/kf1_shibuya_facade_mid.png",
              "assets/keyframes/kf2_path_spline_guide.png"
            ]
          },
          "omni_flash_prompt": {
            "type": "string",
            "description": "Prompt oficial con sintaxis Gemini Omni Flash para Google Flow",
            "example": "[# Sources <FIRST_FRAME>@Image1] [# References <IMAGE_REF_0>@Image2] Animate high-speed cinematic FPV drone flight diving straight down..."
          },
          "hud_telemetry": {
            "type": "object",
            "required": ["speed_display_kmh", "altitude_display_m", "g_force", "battery_pct", "coordinates_text"],
            "properties": {
              "speed_display_kmh": { "type": "number", "example": 124.5 },
              "altitude_display_m": { "type": "number", "example": 180.2 },
              "g_force": { "type": "number", "example": 3.2 },
              "battery_pct": { "type": "integer", "example": 89 },
              "coordinates_text": { "type": "string", "example": "35°39'32.4\"N 139°42'04.8\"E" }
            }
          },
          "spatial_3d_title": {
            "type": "object",
            "required": ["text", "world_anchor_landmark", "depth_layer", "motion_style"],
            "properties": {
              "text": { "type": "string", "example": "SHIBUYA CROSSING" },
              "world_anchor_landmark": { "type": "string", "example": "Facade of 109 Building, Floor 14" },
              "depth_layer": { "type": "string", "enum": ["BACKGROUND", "MIDGROUND", "FOREGROUND", "PASSTHROUGH"], "example": "MIDGROUND" },
              "motion_style": { "type": "string", "example": "Fixed 3D world tracking with glowing neon cyan typography, camera zooms past text at t=3.2s" }
            }
          },
          "audio_sync": {
            "type": "object",
            "required": ["foley_sound_event", "doppler_shift_hz", "bgm_beat_anchor_s"],
            "properties": {
              "foley_sound_event": { "type": "string", "example": "FPV prop high-pitch whine with intense wind roar accelerating into deep low-pass whoosh" },
              "doppler_shift_hz": { "type": "number", "example": 450.0 },
              "bgm_beat_anchor_s": { "type": "number", "example": 3.0 }
            }
          }
        }
      }
    }
  }
}
