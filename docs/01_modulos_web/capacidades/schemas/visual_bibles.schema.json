{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VisualBiblesSchema",
  "description": "Contrato unificado para congelar identidades, escenarios, objetos y estilo visual.",
  "type": "object",
  "required": ["project_id", "style_bible", "character_bible", "location_bible", "prop_bible"],
  "properties": {
    "project_id": { "type": "string", "example": "THE_ARCHIVE_S01" },
    "style_bible": {
      "type": "object",
      "required": ["aesthetic_class", "aspect_ratio", "target_framerate", "color_palette", "optical_signature"],
      "properties": {
        "aesthetic_class": { "type": "string", "example": "Stylized Cinematic 3D Animation, Grounded Human Anatomy, Hyper-tactile Textures" },
        "aspect_ratio": { "type": "string", "enum": ["16:9", "2.39:1", "9:16"] },
        "target_framerate": { "type": "integer", "enum": [24, 30, 60] },
        "color_palette": {
          "type": "object",
          "required": ["primary_color_hex", "secondary_color_hex", "accent_color_hex", "shadow_tint_hex"],
          "properties": {
            "primary_color_hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "example": "#0A192F" },
            "secondary_color_hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "example": "#B87333" },
            "accent_color_hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "example": "#00FFC2" },
            "shadow_tint_hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "example": "#030712" }
          }
        },
        "optical_signature": {
          "type": "object",
          "required": ["simulated_film_stock", "anamorphic_streak", "film_grain_intensity"],
          "properties": {
            "simulated_film_stock": { "type": "string", "example": "Kodak Vision3 5219 500T" },
            "anamorphic_streak": { "type": "boolean", "default": true },
            "film_grain_intensity": { "type": "number", "minimum": 0.0, "maximum": 1.0, "example": 0.15 }
          }
        }
      }
    },
    "character_bible": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["character_id", "canonical_name", "visual_age", "immutable_traits", "wardrobe_variants", "reference_assets"],
        "properties": {
          "character_id": { "type": "string", "example": "CHAR_MICHAEL" },
          "canonical_name": { "type": "string", "example": "Michael Ruiz" },
          "visual_age": { "type": "integer", "example": 36 },
          "immutable_traits": {
            "type": "object",
            "required": ["facial_bone_structure", "eye_color", "hair_style_and_color", "distinctive_marks"],
            "properties": {
              "facial_bone_structure": { "type": "string", "example": "Angular defined jawline, balanced cheekbones, straight nose ridge" },
              "eye_color": { "type": "string", "example": "Dark brown, focused and observant" },
              "hair_style_and_color": { "type": "string", "example": "Short textured dark brown hair with slight side parting" },
              "distinctive_marks": { "type": "string", "example": "Subtle faded horizontal scar on left inner wrist" }
            }
          },
          "wardrobe_variants": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["variant_id", "era_context", "upper_body", "lower_body", "color_scheme"],
              "properties": {
                "variant_id": { "type": "string", "example": "WARDROBE_TECH_EXEC_2012" },
                "era_context": { "type": "string", "example": "Corporate High-Stress Office" },
                "upper_body": { "type": "string", "example": "Wrinkled crisp navy dress shirt with unbuttoned collar, sleeves rolled up to mid-forearm" },
                "lower_body": { "type": "string", "example": "Dark charcoal tailored trousers with matte leather belt" },
                "color_scheme": { "type": "string", "example": "Navy blue, slate grey, subtle brass accents" }
              }
            }
          },
          "reference_assets": {
            "type": "object",
            "required": ["turnaround_4views_url", "expression_sheet_url", "fixed_seed_id"],
            "properties": {
              "turnaround_4views_url": { "type": "string" },
              "expression_sheet_url": { "type": "string" },
              "fixed_seed_id": { "type": "integer", "example": 98452103 }
            }
          }
        }
      }
    },
    "location_bible": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["location_id", "name", "spatial_geometry", "materials_and_textures", "motivated_light_sources"],
        "properties": {
          "location_id": { "type": "string", "example": "LOC_TRADING_FLOOR_MAIN" },
          "name": { "type": "string", "example": "High Frequency Trading Server & Trading Hub" },
          "spatial_geometry": { "type": "string", "example": "Open floor plan, rows of dense trading desks, wall of 65-inch market monitors" },
          "materials_and_textures": { "type": "string", "example": "Brushed aluminum server racks, anti-static dark grey carpet, tempered glass dividers" },
          "motivated_light_sources": { "type": "string", "example": "Overhead fluorescent tubes (4000K), harsh cyan monitor screen emissions, red LED server rack indicators" }
        }
      }
    },
    "prop_bible": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["prop_id", "name", "physical_description", "narrative_function"],
        "properties": {
          "prop_id": { "type": "string", "example": "PROP_BLACK_NOTEBOOK" },
          "name": { "type": "string", "example": "Michael's Black Moleskine Notebook" },
          "physical_description": { "type": "string", "example": "Worn black leatherbound journal, cream acid-free lined pages, elastic closure band, silver ink notes" },
          "narrative_function": { "type": "string", "example": "Recurring continuity bridge between historical lives and the overarching mystery" }
        }
      }
    }
  }
}
